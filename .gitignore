# ── Local databases (contain ingested PII) ─────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/inspro.db*
backend/tests/_test_*.db*

# ── Real client PII (placement slips, roster uploads) ──────────────────────
# The repo's test fixtures must use synthetic data (see decision #2 in plan).
# Real-client files remain on disk locally for ad-hoc parser checks but must
# NEVER reach the remote.
reference/
backend/tests/fixtures/placement_slips/*.xls
backend/tests/fixtures/placement_slips/*.xlsx
backend/tests/fixtures/rosters/*.xlsx
!backend/tests/fixtures/placement_slips/.gitkeep
!backend/tests/fixtures/rosters/.gitkeep

# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
backend/.env
frontend/.env
frontend/.env.local
infra/bicep/parameters.*.local.json

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / frontend ────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Build / deploy artefacts ───────────────────────────────────────────────
*.zip
backend.zip
frontend.zip
tmp/

# Retained document storage (claim receipts, dependant proofs) — PII
backend/var/

# Design-skill working state (audits, critiques, question state). The
# deliverables it produces — DESIGN.md, docs/ — are committed; this is scratch.
.impeccable/

# Markdown is not committed — docs live on disk for local/assistant reference
# only, deliberately not in the repo. Files stay in the working tree; they are
# just never tracked. (CLAUDE.md is already excluded by the global gitignore.)
*.md
!docs/PRODUCTION_RESILIENCE_RUNBOOK.md
