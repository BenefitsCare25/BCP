# ── Local databases (contain ingested PII) ─────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/inspro.db*
backend/tests/_test_*.db*

# ── Real client PII (placement slips, roster uploads) ──────────────────────
# The repo's test fixtures must use synthetic data (see decision #2 in plan).
# Real-client files remain on disk locally for ad-hoc parser checks but must
# NEVER reach the remote.
reference/
backend/tests/fixtures/placement_slips/*.xls
backend/tests/fixtures/placement_slips/*.xlsx
backend/tests/fixtures/rosters/*.xlsx
!backend/tests/fixtures/placement_slips/.gitkeep
!backend/tests/fixtures/rosters/.gitkeep

# Ad-hoc real-client Office exports generated at the repository root. Keep the
# files available for local reconciliation, but never allow them into commits.
/*.xls
/*.xlsx
/*.doc
/*.docx

# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
backend/.env
frontend/.env
frontend/.env.local
infra/bicep/parameters.*.local.json

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / frontend ────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Build / deploy artefacts ───────────────────────────────────────────────
*.zip
backend.zip
frontend.zip
tmp/

# Retained document storage (claim receipts, dependant proofs) — PII
backend/var/

# Design-skill working state (audits, critiques, question state) is scratch.
.impeccable/

# Markdown stays local by default; selected published docs are allowed below.
# Existing tracked documents remain tracked. CLAUDE.md is also globally ignored.
*.md
!docs/PRODUCTION_RESILIENCE_RUNBOOK.md

# Versioned AI Settings documentation and the dated readiness baseline.
# Other Markdown remains local unless explicitly listed here.
!docs/AI_COMPLIANCE_READINESS_2026-09-28.md
!docs/AI_GOVERNANCE_IMPLEMENTATION_PLAN.md
!docs/AI_GOVERNANCE_UX_DESIGN.md
!docs/AI_SETTINGS.md
