        "description": "From address for portal OTP mail (defaults to smtpUser)."
      }
    },
    "smtpPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP password (passed via CI --parameters override)."
      }
