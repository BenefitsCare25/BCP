{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "Secrets (postgresAdminPassword, azureFoundryApiKey, containerImage, entraTenantId, entraClientId, acrLoginServer) are NOT in this file — CI passes them via --parameters overrides sourced from GitHub Secrets. See .github/workflows/deploy.yml.",
  "parameters": {
    "env": { "value": "staging" },
    "location": { "value": "southeastasia" },
    "appServicePlanSku": { "value": "B1" },
    "postgresSku": { "value": "Standard_B1ms" },
    "postgresTier": { "value": "Burstable" },
    "postgresAdminUser": { "value": "insproadmin" },
    "postgresBackupRetentionDays": { "value": 14 },
    "postgresGeoRedundantBackup": { "value": false },
    "redisSku": { "value": "Basic" },
    "redisCapacity": { "value": 0 },
    "corsOrigins": { "value": "https://inspro-staging.azurewebsites.net" },
    "azureFoundryEndpoint": { "value": "https://inspro-foundry.services.ai.azure.com/anthropic/" }
  }
}
