# ── AI provider (optional) ─────────────────────────────────────────────────
# Set ONE of the two providers below. If both are set, Azure Foundry wins.

# Azure AI Foundry (recommended — exposes Claude via an Anthropic-compatible endpoint)
# Endpoint format: https://<resource>.services.ai.azure.com/anthropic/
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic/
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_MODEL=claude-sonnet-4-20250514

# Direct Anthropic (local dev fallback)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (Claude in Singapore/APAC — per-token, data-resident).
# Select with INSPRO_AI_PROVIDER=bedrock. Auth uses the standard AWS credential
# chain: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for local dev; role or
# Entra->AWS federation in prod. Use a single-region or apac.* inference
# profile — NEVER a global.* one (prod refuses to boot on it).
# NOTE: newer Claude models (Sonnet 4.5/5, Haiku 4.5) are GLOBAL-only on Bedrock
# (not APAC-resident). The newest ACTIVE Singapore/APAC-resident profile is
# Claude 3.5 Sonnet v2 below — use it to keep claim data in-region.
# INSPRO_AI_PROVIDER=bedrock
# AWS_BEDROCK_REGION=ap-southeast-1
# AWS_BEDROCK_MODEL=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Encryption (required) ──────────────────────────────────────────────────
# 32-byte Fernet key for BYOK secret storage. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INSPRO_AI_KEY_ENCRYPTION_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Defaults to ./inspro.db if unset. Override for Postgres in Phase 1.
# INSPRO_DATABASE_URL=postgresql+psycopg://user:pass@host/db
