# ── AI provider (optional) ─────────────────────────────────────────────────
# Google Vertex AI (Gemini) is the SOLE provider — Singapore data-resident,
# per-token. (AWS Bedrock + direct Anthropic were removed.)
#
# Select with INSPRO_AI_PROVIDER=vertex (or just set VERTEX_PROJECT). Auth uses
# the standard Google ADC chain (GOOGLE_APPLICATION_CREDENTIALS=path/to/service-
# account.json for local dev; workload identity in prod). VERTEX_LOCATION must
# be asia-southeast1 — prod refuses to boot on any other region. Per-tenant BYOK
# (the AI provider settings page) supersedes these; there it stores the service-
# account JSON encrypted.
# INSPRO_AI_PROVIDER=vertex
# VERTEX_PROJECT=inspro-ai
# VERTEX_LOCATION=asia-southeast1
# VERTEX_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── AI spend caps + concurrency (all tenants share one key/quota) ────────────
# PREFERRED: set these in the UI — Configuration → AI provider → "Platform AI
# limits" (system-admin only). Those values are stored in the DB and OVERRIDE
# the env vars below, which act only as a fallback before anything is configured.
# All three: 0/unset = that limit disabled.
#
# Platform-wide monthly token cap across ALL clients — a hard backstop so one
# busy company can't exhaust the shared Vertex quota for everyone. Set below
# your Google project's tokens/day * ~30 headroom.
# INSPRO_AI_PLATFORM_MONTHLY_TOKEN_CAP=0
# Fleet-wide default per-tenant monthly token budget, applied to any client
# whose own ai_monthly_token_budget is 0/unset (so "0" stops meaning unlimited).
# An explicit per-tenant budget always wins.
# INSPRO_AI_DEFAULT_MONTHLY_TOKEN_BUDGET=0
# Max concurrent LIVE provider calls per process (backpressure for bursts such
# as 100 members submitting at once). Effective cap across N App Service
# instances is this * N.
# INSPRO_AI_MAX_CONCURRENT_CALLS=0
# Fraction of a cap at which a WARNING is logged (wire to Cloud Monitoring for
# an early alert before the hard cap trips). Env-only. Default 0.8 (80%).
# INSPRO_AI_BUDGET_ALERT_THRESHOLD=0.8

# ── Encryption (required) ──────────────────────────────────────────────────
# 32-byte Fernet key for BYOK secret storage. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INSPRO_AI_KEY_ENCRYPTION_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Defaults to ./inspro.db if unset. Override for Postgres in Phase 1.
# INSPRO_DATABASE_URL=postgresql+psycopg://user:pass@host/db
